<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".roles">

    <!-- ✨ NEW: Background Image (to match other screens) ✨ -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85"
        android:contentDescription="@string/background_image"
        android:scaleType="centerCrop"
        android:src="@drawable/background_image1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title for the page -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/bg_barbers"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.8" />

    <!-- Subtitle or instruction -->
    <TextView
        android:id="@+id/subtitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/choose_your_role"
        android:textColor="#CCCCCC"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/customerLoginButton"
        app:layout_constraintEnd_toEndOf="@+id/customerLoginButton"
        app:layout_constraintStart_toStartOf="@+id/customerLoginButton" />

    <!-- Button to log in as a Customer -->
    <Button
        android:id="@+id/customerLoginButton"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:backgroundTint="#00008B"
        android:text="@string/customer"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48" />

    <!-- Button to log in as a Barber -->
    <Button
        android:id="@+id/barberLoginButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#555555"
        android:text="@string/barber"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/customerLoginButton"
        app:layout_constraintStart_toStartOf="@+id/customerLoginButton"
        app:layout_constraintTop_toBottomOf="@+id/customerLoginButton" />

    <!-- Clickable TextView to go to the Sign Up page -->
    <TextView
        android:id="@+id/signupTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/barberLoginButton"
        app:layout_constraintStart_toStartOf="@+id/barberLoginButton"
        app:layout_constraintTop_toBottomOf="@+id/barberLoginButton"
        tools:text="Don't have an account? Sign up" />

</androidx.constraintlayout.widget.ConstraintLayout>
